{
  "name": "practica-react",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para práctica de React con frontend y backend",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" --names \"CLIENT,SERVER\" --prefix-colors \"cyan,yellow\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "install:all": "npm install",
    "clean": "rimraf node_modules client/node_modules server/node_modules"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.2"
  }
}
